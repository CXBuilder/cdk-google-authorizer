{
  "name": "@cxbuilder/google-authorizer",
  "version": "1.0.0",
  "license": "MIT-0",
  "description": "Lambda@Edge CDK construct that gates CloudFront distributions behind Google OAuth",
  "author": {
    "name": "CXBuilder",
    "email": "ivan@cxbuilder.ai",
    "url": "https://www.cxbuilder.ai"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/cxbuilder/cdk-google-authorizer.git"
  },
  "bugs": {
    "url": "https://github.com/cxbuilder/cdk-google-authorizer/issues"
  },
  "homepage": "https://github.com/cxbuilder/cdk-google-authorizer#readme",
  "keywords": [
    "aws",
    "cdk",
    "cloudfront",
    "lambda-edge",
    "google",
    "oauth",
    "oidc",
    "authorizer",
    "google-workspace"
  ],
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "src/lambda/dist",
    "CHANGELOG.md",
    "LICENSE",
    "README.md"
  ],
  "engines": {
    "node": ">=22.0.0"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "scripts": {
    "clean": "rimraf dist src/lambda/dist",
    "bundle-lambda": "node scripts/bundle-lambda.js",
    "build": "npm run clean && npm run bundle-lambda && tsc",
    "watch": "tsc -w",
    "test": "jest",
    "check-version": "if test $(npm view $npm_package_name version) = $npm_package_version ; then echo 'You must increment package version' ; exit 1 ; fi"
  },
  "devDependencies": {
    "@aws-sdk/client-secrets-manager": "^3.700.0",
    "@types/aws-lambda": "^8.10.149",
    "@types/jest": "^29.5.14",
    "@types/node": "22.7.9",
    "aws-cdk-lib": "2.233.0",
    "constructs": "10.4.4",
    "esbuild": "^0.25.5",
    "jest": "^29.7.0",
    "jose": "^5.9.6",
    "rimraf": "^6.0.1",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "typescript": "~5.6.3"
  },
  "peerDependencies": {
    "aws-cdk-lib": "^2.233.0",
    "constructs": "^10.0.0"
  }
}
